# Supabase project settings — client-safe (never expose the service-role key this way).
# Find these in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used exclusively by scripts/seed.ts (never imported by app code
# that ships to the browser). Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional convenience alias some Supabase CLI workflows expect.
SUPABASE_URL=https://your-project-ref.supabase.co

# The email of the athlete account scripts/seed.ts should seed the plan for.
# Sign up in the app first, then run `npm run seed`.
SEED_USER_EMAIL=you@example.com
